# Compiled binaries, object files, and libraries
*.o
*.obj
*.exe
*.dll
*.so
*.dylib
*.a
*.lib
*.pdb
*.ilk

# CMake and build directories
build/
cmake-build-*/
out/
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
CTestTestfile.cmake
compile_commands.json

# Compiler tooling caches
.cache/

# IDE & editor files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
*.suo
*.user
*.sln.docstates
.vs/
Thumbs.db
.DS_Store

# Python (plotting scripts and notebooks only)
.venv/
venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Generated data and results (folders stay tracked through .gitkeep).
# Raw results are reproducible from a dataset + config, so they are not committed;
# hand-made sample datasets (data/synthetic/sample_*) are.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/synthetic/*
!data/synthetic/.gitkeep
!data/synthetic/sample_*/
data/skill_based/*
!data/skill_based/.gitkeep
results/metrics/*
!results/metrics/.gitkeep
results/plots/*
!results/plots/.gitkeep
results/figures/*
!results/figures/.gitkeep
results/tables/*
!results/tables/.gitkeep

# Logs
*.log
