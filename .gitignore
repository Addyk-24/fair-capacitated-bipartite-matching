# Compiled binaries, object files, and libraries
*.o
*.obj
*.exe
*.dll
*.so
*.dylib
*.a
*.lib
*.pdb
*.ilk

# CMake and build directories
build/
bin/
lib/
out/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
CTestTestfile.cmake
Makefile

# Clang / Compiler tooling artifacts
compile_commands.json
.cache/
.clang-format-working-copy

# IDE & Editor files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
*.suo
*.user
*.userosv
*.sln.docstates
.vs/
Thumbs.db
.DS_Store

# Output results and runtime logs (tracked via .gitkeep)
results/figures/*
!results/figures/.gitkeep
results/tables/*
!results/tables/.gitkeep
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Local experiment logs
*.log
experiments/*.pyc
experiments/__pycache__/